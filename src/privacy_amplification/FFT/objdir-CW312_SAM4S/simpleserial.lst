 260:.././simpleserial/simpleserial.c **** 	uint8_t flags;
 261:.././simpleserial/simpleserial.c **** } ss_cmd;
 262:.././simpleserial/simpleserial.c **** static ss_cmd commands[MAX_SS_CMDS];
