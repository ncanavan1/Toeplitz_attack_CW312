 202:Toeplitz_FFT.c ****     for(int stage=1; stage <= s; stage++){
 203:Toeplitz_FFT.c ****         // Powers of two, computed with bit-shifts rather than pow(2,...):
 204:Toeplitz_FFT.c ****         // this target has no hardware FPU (-mfloat-abi=soft), so pow() is
 205:Toeplitz_FFT.c ****         // a software-emulated transcendental call, and the old code was
 206:Toeplitz_FFT.c ****         // calling it (plus a redundant one inside the while-condition,
 207:Toeplitz_FFT.c ****         // evaluated on every iteration) tens of thousands of times per
 208:Toeplitz_FFT.c ****         // hash at larger N -- easily seconds of wasted time for what's
 209:Toeplitz_FFT.c ****         // always just an integer power of two.
 210:Toeplitz_FFT.c ****         int half_span = 1 << (stage - 1);
 211:Toeplitz_FFT.c ****         int span = 1 << stage;
 212:Toeplitz_FFT.c ****         int table_stride = N >> stage;  // N/span
 213:Toeplitz_FFT.c ****         int p = 0;
