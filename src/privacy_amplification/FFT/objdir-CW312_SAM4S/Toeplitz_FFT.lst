 270:Toeplitz_FFT.c **** #if KEY_FFT_ONLY
 271:Toeplitz_FFT.c **** 
 272:Toeplitz_FFT.c **** // Trace-gathering build: only the triggered key FFT, nothing else -- see
 273:Toeplitz_FFT.c **** // the KEY_FFT_ONLY comment above.
 274:Toeplitz_FFT.c **** void Toeplitz_hash_fft_key_only(int *input_key, int N){
 275:Toeplitz_FFT.c ****     // static: see the RAM comment on Toeplitz_hash_fft_seeded (the full
 276:Toeplitz_FFT.c ****     // build's equivalent). Only one ROWBITS-sized complex array here,
 277:Toeplitz_FFT.c ****     // since there's no seed to hold.
 278:Toeplitz_FFT.c ****     static float complex key_fft[ROWBITS];
 279:Toeplitz_FFT.c **** 
 280:Toeplitz_FFT.c ****     for(int i = 0; i < N; i++){
 281:Toeplitz_FFT.c ****       key_fft[i] = input_key[i] + 0*I;
 282:Toeplitz_FFT.c ****     }
 283:Toeplitz_FFT.c **** 
 284:Toeplitz_FFT.c ****     DIT_FFT(key_fft, N, 1, 1);   // triggered: key NTT, stop right after stage 1 -- the
 285:Toeplitz_FFT.c ****                                   // rest is never captured and nothing reads key_fft
 286:Toeplitz_FFT.c ****                                   // again in this build, so computing it would be pure
 287:Toeplitz_FFT.c ****                                   // wasted time before the target's back in read_bytes().
 288:Toeplitz_FFT.c **** }
 289:Toeplitz_FFT.c **** 
 290:Toeplitz_FFT.c **** #else
 291:Toeplitz_FFT.c **** 
 292:Toeplitz_FFT.c **** // Seeded variant: instead of deriving the circulant from a Toeplitz row/col
 293:Toeplitz_FFT.c **** // spec, a random seed of the same length as the key is FFT'd and pointwise
 294:Toeplitz_FFT.c **** // multiplied with the key's FFT (circular convolution of key and seed),
 295:Toeplitz_FFT.c **** // then IFFT'd and reduced mod 2. Only the key's FFT is triggered so power
 296:Toeplitz_FFT.c **** // traces capture leakage from the key-dependent NTT butterfly and nothing
 297:Toeplitz_FFT.c **** // else.
