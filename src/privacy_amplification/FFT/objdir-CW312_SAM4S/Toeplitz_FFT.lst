  62:Toeplitz_FFT.c ****     ;
  63:Toeplitz_FFT.c ****   }
  64:Toeplitz_FFT.c **** }
  65:Toeplitz_FFT.c **** 
  66:Toeplitz_FFT.c **** // Raw binary byte I/O for the key/seed/result protocol -- no framing, no
  67:Toeplitz_FFT.c **** // text. getch() blocks until a real byte is received (confirmed from the
  68:Toeplitz_FFT.c **** // SAM4S HAL: uart_read() itself spins until data is available, so unlike
  69:Toeplitz_FFT.c **** // the old line-based my_read() there's no "0 means not ready yet" sentinel
  70:Toeplitz_FFT.c **** // to guard against; every byte returned is genuine received data,
  71:Toeplitz_FFT.c **** // including a legitimate 0x00).
