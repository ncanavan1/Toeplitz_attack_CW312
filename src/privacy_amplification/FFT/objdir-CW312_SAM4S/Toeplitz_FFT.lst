 227:Toeplitz_FFT.c **** 
 228:Toeplitz_FFT.c **** 
 229:Toeplitz_FFT.c ****             // for(int i = 0; i < 20; i++){
 230:Toeplitz_FFT.c ****             //     __asm__ volatile ("nop");
 231:Toeplitz_FFT.c ****             // }
 232:Toeplitz_FFT.c **** 
 233:Toeplitz_FFT.c ****             z *= w;
 234:Toeplitz_FFT.c ****             X[p] = y+z;
 235:Toeplitz_FFT.c ****             X[q] = y-z;
 236:Toeplitz_FFT.c **** 
 237:Toeplitz_FFT.c ****             p++;
 238:Toeplitz_FFT.c ****             q++;
 239:Toeplitz_FFT.c ****             n++;
 240:Toeplitz_FFT.c ****             if(q % span == 0){
 241:Toeplitz_FFT.c ****                 p = p + half_span;
 242:Toeplitz_FFT.c ****                 q = q + half_span;
