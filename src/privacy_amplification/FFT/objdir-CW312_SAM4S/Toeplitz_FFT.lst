   9:Toeplitz_FFT.c **** #define IDLE 0
  10:Toeplitz_FFT.c **** #define KEY 1
  11:Toeplitz_FFT.c **** #define PLAIN 2
  12:Toeplitz_FFT.c **** #define PI 3.1415926535897932384626433832795  // Value of Pi
  13:Toeplitz_FFT.c **** #define BUFLEN 64
  14:Toeplitz_FFT.c **** 
  15:Toeplitz_FFT.c **** // Key/seed size in BYTES. Set at build time with `make ROWLEN=<n>`; changing
  16:Toeplitz_FFT.c **** // it requires a rebuild since the FFT length is baked into the binary.
  17:Toeplitz_FFT.c **** // The Toeplitz hash itself is bit-level (GF(2)), so each byte is expanded
  18:Toeplitz_FFT.c **** // into 8 individual bits before hashing -- ROWBITS is that bit-vector
  19:Toeplitz_FFT.c **** // length, and it's what actually needs to be a power of two for the
  20:Toeplitz_FFT.c **** // radix-2 DIT FFT.
  21:Toeplitz_FFT.c **** // 128 bytes (1024 bits) is a tested, comfortable ceiling for this SAM4S
  22:Toeplitz_FFT.c **** // target's 64KB of RAM (~51% used); 256 bytes builds but leaves under 5%
  23:Toeplitz_FFT.c **** // headroom, and 512+ fails to link outright -- see the RAM comment on
  24:Toeplitz_FFT.c **** // Toeplitz_hash_fft_seeded.
  25:Toeplitz_FFT.c **** #ifndef ROWLEN
  26:Toeplitz_FFT.c **** #define ROWLEN 128
  27:Toeplitz_FFT.c **** #endif
  28:Toeplitz_FFT.c **** 
  29:Toeplitz_FFT.c **** #define ROWBITS (ROWLEN * 8)
  30:Toeplitz_FFT.c **** 
  31:Toeplitz_FFT.c **** #if (ROWBITS & (ROWBITS - 1)) != 0
  32:Toeplitz_FFT.c **** #error "ROWLEN*8 must be a power of two (required by the radix-2 DIT FFT)"
  33:Toeplitz_FFT.c **** #endif
  34:Toeplitz_FFT.c **** 
  35:Toeplitz_FFT.c **** // Build two different executables from this one source file:
  36:Toeplitz_FFT.c **** //   KEY_FFT_ONLY=0 (default): the full Toeplitz hash (key FFT, seed FFT,
  37:Toeplitz_FFT.c **** //     pointwise multiply, IFFT, mod2) -- what's needed for a real,
  38:Toeplitz_FFT.c **** //     correct privacy-amplification key.
  39:Toeplitz_FFT.c **** //   KEY_FFT_ONLY=1: only reads a key, echoes it, and runs the triggered
  40:Toeplitz_FFT.c **** //     key FFT -- nothing else. For SCA trace gathering, the triggered key
  41:Toeplitz_FFT.c **** //     FFT is the only part that's ever actually captured (see the
  42:Toeplitz_FFT.c **** //     `trigger` comment on DIT_FFT); the seed FFT/IFFT/mod2 stages just
  43:Toeplitz_FFT.c **** //     burn UART and compute time between traces without ever appearing in
  44:Toeplitz_FFT.c **** //     a trace. Dropping them (and the seed's RAM entirely -- no seed_fft,
  45:Toeplitz_FFT.c **** //     no seed/output byte or bit arrays) shortens the per-trace round
  46:Toeplitz_FFT.c **** //     trip, so more traces can be collected per unit wall-clock time.
  47:Toeplitz_FFT.c **** #ifndef KEY_FFT_ONLY
  48:Toeplitz_FFT.c **** #define KEY_FFT_ONLY 0
  49:Toeplitz_FFT.c **** #endif
  50:Toeplitz_FFT.c **** 
