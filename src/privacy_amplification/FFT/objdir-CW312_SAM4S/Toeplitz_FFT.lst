 164:Toeplitz_FFT.c **** 
 165:Toeplitz_FFT.c **** 
 166:Toeplitz_FFT.c **** // Precomputed twiddle table, indexed as table[n * (N/span)] for a stage
 167:Toeplitz_FFT.c **** // with span = 2^stage: exp(-2*pi*i*n/span) == exp(-2*pi*i*(n*(N/span))/N),
 168:Toeplitz_FFT.c **** // so a single length-N/2 table (the N-point DFT's twiddle factors) covers
 169:Toeplitz_FFT.c **** // every stage via a stride lookup, rather than calling cexp() (needing
 170:Toeplitz_FFT.c **** // soft-emulated sin/cos on this FPU-less target) on every butterfly.
 171:Toeplitz_FFT.c **** // `static const` here means the values live in .rodata (flash), not
 172:Toeplitz_FFT.c **** // .bss/.data (RAM) -- verified against the actual toolchain. The table is
 173:Toeplitz_FFT.c **** // computed offline by gen_twiddle_table.py (C has no constexpr, so cexp()
 174:Toeplitz_FFT.c **** // can't run in a static initializer) and regenerated for the current
 175:Toeplitz_FFT.c **** // ROWLEN on every build; see twiddle_table.h.
 176:Toeplitz_FFT.c **** #include "twiddle_table.h"
 177:Toeplitz_FFT.c **** 
 178:Toeplitz_FFT.c **** //https://github.com/Swati-Verma671/Computation-of-DFT-using-Radix-2-DIT-FFT-algorithm/blob/main/co
 179:Toeplitz_FFT.c **** // `trigger`: when nonzero, raises the CW trigger for the duration of stage 1
 180:Toeplitz_FFT.c **** // of the butterfly (dropping it again once stage 2 begins). Callers pass 0
 181:Toeplitz_FFT.c **** // for every FFT call that should NOT be visible in a power trace (the seed's
 182:Toeplitz_FFT.c **** // FFT, and the FFT performed internally by DIT_IFFT).
 183:Toeplitz_FFT.c **** //
 184:Toeplitz_FFT.c **** // `stop_after_stage1`: when nonzero, returns as soon as stage 1 finishes
 185:Toeplitz_FFT.c **** // instead of computing the remaining log2(N)-1 stages. Only stage 1 is ever
 186:Toeplitz_FFT.c **** // triggered/captured, so for KEY_FFT_ONLY's trace-gathering build (see
 187:Toeplitz_FFT.c **** // Toeplitz_hash_fft_key_only) every later stage is pure wasted soft-float
 188:Toeplitz_FFT.c **** // compute time between traces -- worse, it delays the target getting back
 189:Toeplitz_FFT.c **** // to read_bytes() for the *next* key long enough that a host write can land
 190:Toeplitz_FFT.c **** // before the target is listening again, desyncing the UART (single holding
 191:Toeplitz_FFT.c **** // register, no FIFO). Callers that need a correct FFT result (the full
 192:Toeplitz_FFT.c **** // hash's key/seed FFTs, and DIT_IFFT) must pass 0 here.
 193:Toeplitz_FFT.c **** void DIT_FFT(float complex *X, int N, int trigger, int stop_after_stage1){
